DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/waterwatch
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

ML_MODE=mock
ML_SERVICE_URL=http://localhost:8001/predict

# Set to external when this endpoint provides live weather, flood, water-body,
# and sanitation-risk signals for a supplied latitude/longitude.
ENVIRONMENTAL_RISK_MODE=mock
ENVIRONMENTAL_RISK_SERVICE_URL=http://localhost:8002/assess

ALERT_RADIUS_KM=10

APP_ENV=development

FRONTEND_URL=https://watch-sight.lovable.app
